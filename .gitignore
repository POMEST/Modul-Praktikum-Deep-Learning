# Secara default, jangan lacak isi folder Praktikum.
/*

# Simpan aturan ini agar kebijakan allowlist ikut masuk repository.
!/.gitignore

# Berkas dan folder yang boleh dipublikasikan.
!/requirements.txt
!/notebooks/
!/data/
!/templates/

# Dataset hasil unduhan bersifat besar dan dapat dibuat ulang.
/data/raw/

# Dokumentasi dan pembuat laporan hasil eksperimen.
!/README.md
!/requirements-tools.txt
!/scripts/

# Cache, lingkungan, dan bobot model tidak dipublikasikan.
__pycache__/
.ipynb_checkpoints/
*.pt
*.pth
.env
.env.*

!/.gitattributes
